<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0/EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.thc.spr202602.mapper.BoardMapper">

	<!---->
	<select id="detail" parameterType="hashMap" resultType="com.thc.spr202602.dto.BoardDto$DetailResDto">
		SELECT
            board.id
             , board.deleted
             , board.created_at as createdAt
             , board.modified_at as modifiedAt
			, board.user_id as userId
			, board.title
			, board.content
			, board.author
		FROM board
		WHERE board.id = #{id}
	</select>

	<!-- 공통 WHERE 절 -->
	<sql id="commonWhere">
		WHERE board.id is not NULL
		<if test = "deleted != null">AND board.deleted = #{deleted}</if>
		<if test = "userId != null">AND board.user_id = #{userId}</if>
		<if test = "title != null and title !=''">AND board.title LIKE CONCAT('%', #{title}, '%')</if>
	</sql>

	<select id="list" parameterType="hashMap" resultType="com.thc.spr202602.dto.BoardDto$DetailResDto">
		SELECT board.id
		FROM board
		<include refid="commonWhere"/>
	</select>
	<select id="listCount" parameterType="hashMap" resultType="Integer">
		SELECT count(board.id)
		FROM board
		<include refid="commonWhere"/>
	</select>
	<select id="pagedList" parameterType="hashMap" resultType="com.thc.spr202602.dto.BoardDto$DetailResDto">
		SELECT board.id
		FROM board
		<include refid="commonWhere"/>
		<if test = "orderby != null and orderby =='id'">ORDER BY board.id </if>
		<if test = "orderby != null and orderby =='title'">ORDER BY board.title </if>
		<if test = "orderway != null and orderway =='ASC'"> ASC</if>
		<if test = "orderway != null and orderway =='DESC'"> DESC</if>
		LIMIT #{offset}, #{perpage}
	</select>


	<select id="scrollList" parameterType="hashMap" resultType="com.thc.spr202602.dto.BoardDto$DetailResDto">
		SELECT board.id
		FROM board
		<include refid="commonWhere"/>

		<if test = "orderby != null and orderby =='title'">
			<if test = "orderway != null and orderway =='DESC'">
				<if test = "mark != null and mark !=''">AND #{mark} > CONCAT(board.title, '_', board.id) </if>
				ORDER BY board.title DESC
			</if>
			<if test = "orderway != null and orderway =='ASC'">
				<if test = "mark != null and mark !=''">AND CONCAT(board.title, '_', board.id) > #{mark} </if>
				ORDER BY board.title ASC
			</if>
		</if>
		<if test = "orderby != null and orderby =='id'">
			<if test = "orderway != null and orderway =='DESC'">
				<if test = "cursor != null">AND #{cursor} > board.id</if>
				ORDER BY board.id DESC
			</if>
			<if test = "orderway != null and orderway =='ASC'">
				<if test = "cursor != null">AND board.id > #{cursor} </if>
				ORDER BY board.id ASC
			</if>
		</if>
		LIMIT 0, #{perpage}
	</select>

</mapper>
